{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "commands": [
    {
      "description": "Suma un clic al contador",
      "exposed": true,
      "id": "contador.incrementar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Incrementar"
    },
    {
      "description": "Suma varios clics al contador",
      "exposed": true,
      "id": "contador.sumar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cantidad": {
            "description": "Clics que se suman",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "cantidad"
        ],
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Sumar"
    },
    {
      "description": "Vuelve el contador a cero",
      "exposed": true,
      "id": "contador.reiniciar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "destructive",
      "title": "Reiniciar"
    },
    {
      "description": "Registra el nombre y limpia el formulario",
      "exposed": true,
      "id": "form.enviar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "outputSchema": {
        "type": [
          "string",
          "null"
        ]
      },
      "safety": "mutating",
      "title": "Enviar"
    },
    {
      "description": "Borra el nombre, el correo, el rol y los términos",
      "exposed": true,
      "id": "form.limpiar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Limpiar"
    },
    {
      "exposed": false,
      "id": "form.alternar_contrasena",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Mostrar u ocultar contraseña"
    },
    {
      "exposed": true,
      "id": "form.ultimo_envio",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "query",
      "outputSchema": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "Último envío"
    },
    {
      "description": "Muestra una sección de la demo, como un clic en la barra lateral",
      "exposed": true,
      "id": "ui.ir_a",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "seccion": {
            "description": "Sección que se muestra",
            "oneOf": [
              {
                "const": "inicio",
                "description": "Fondo de ventana, contador, formulario y estadísticas.",
                "type": "string"
              },
              {
                "const": "campos",
                "description": "Variantes de TextField.",
                "type": "string"
              },
              {
                "const": "botones",
                "description": "Botones, tamaños e IconButtons.",
                "type": "string"
              },
              {
                "const": "seleccion",
                "description": "Switches, checkboxes, selects y controles segmentados.",
                "type": "string"
              },
              {
                "const": "contenedores",
                "description": "Cards, group boxes, estadísticas y texto.",
                "type": "string"
              },
              {
                "const": "badges",
                "description": "Badges y alertas.",
                "type": "string"
              },
              {
                "const": "multimedia",
                "description": "Avatares, imágenes y campos de imagen (foto, portada, logo).",
                "type": "string"
              },
              {
                "const": "tabla",
                "description": "Tabla de 10 000 clientes y lista virtualizada.",
                "type": "string"
              },
              {
                "const": "dialogos",
                "description": "Diálogos, avisos (toasts) y la paleta de comandos.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "seccion"
        ],
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Ir a sección"
    },
    {
      "description": "Colapsa la barra lateral a un riel de íconos o la expande",
      "exposed": true,
      "id": "ui.alternar_sidebar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Mostrar u ocultar barra lateral"
    },
    {
      "description": "Muestra un aviso (toast) que se cierra solo a los 4 segundos",
      "exposed": true,
      "id": "avisos.mostrar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "variante": {
            "description": "Variante del aviso",
            "enum": [
              "exito",
              "error",
              "advertencia",
              "info"
            ],
            "type": "string"
          }
        },
        "required": [
          "variante"
        ],
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Mostrar aviso"
    },
    {
      "description": "Descarga una imagen y la muestra en el avatar de la sección Multimedia",
      "exposed": true,
      "id": "multimedia.cargar_url",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "url": {
            "description": "Dirección http(s) de una imagen png, jpg o webp; vacía, vuelve al ícono",
            "type": "string"
          }
        },
        "required": [
          "url"
        ],
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Cargar imagen desde URL"
    }
  ],
  "format": 1
}
