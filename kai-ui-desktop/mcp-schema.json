{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "commands": [
    {
      "description": "Suma un clic al contador",
      "exposed": true,
      "id": "contador.incrementar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Incrementar"
    },
    {
      "description": "Suma varios clics al contador",
      "exposed": true,
      "id": "contador.sumar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "cantidad": {
            "description": "Clics que se suman",
            "format": "uint32",
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "cantidad"
        ],
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Sumar"
    },
    {
      "description": "Vuelve el contador a cero",
      "exposed": true,
      "id": "contador.reiniciar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "destructive",
      "title": "Reiniciar"
    },
    {
      "description": "Registra el nombre y limpia el formulario",
      "exposed": true,
      "id": "form.enviar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "outputSchema": {
        "type": [
          "string",
          "null"
        ]
      },
      "safety": "mutating",
      "title": "Enviar"
    },
    {
      "description": "Borra el nombre, el correo, el rol y los términos",
      "exposed": true,
      "id": "form.limpiar",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Limpiar"
    },
    {
      "exposed": false,
      "id": "form.alternar_contrasena",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Mostrar u ocultar contraseña"
    },
    {
      "exposed": true,
      "id": "form.ultimo_envio",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {},
        "type": "object"
      },
      "kind": "query",
      "outputSchema": {
        "type": [
          "string",
          "null"
        ]
      },
      "title": "Último envío"
    },
    {
      "description": "Muestra una sección de la demo, como un clic en la barra lateral",
      "exposed": true,
      "id": "ui.ir_a",
      "inputSchema": {
        "additionalProperties": false,
        "properties": {
          "seccion": {
            "description": "Sección que se muestra",
            "oneOf": [
              {
                "const": "inicio",
                "description": "Fondo de ventana, contador, formulario y estadísticas.",
                "type": "string"
              },
              {
                "const": "campos",
                "description": "Variantes de TextField.",
                "type": "string"
              },
              {
                "const": "botones",
                "description": "Botones, tamaños e IconButtons.",
                "type": "string"
              },
              {
                "const": "badges",
                "description": "Badges y alertas.",
                "type": "string"
              }
            ]
          }
        },
        "required": [
          "seccion"
        ],
        "type": "object"
      },
      "kind": "action",
      "safety": "mutating",
      "title": "Ir a sección"
    }
  ],
  "format": 1
}
